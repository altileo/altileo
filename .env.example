# Optional: webhook URL (Slack/Discord/HubSpot) for instant lead pings.
LEAD_WEBHOOK_URL=

# Site URL — used for SEO metadata, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://altileo.com
